# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ────────────────────────────────────────────────
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml

# ── Frontend (Next.js) ──────────────────────────────────────────
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
*.tsbuildinfo
frontend/next-env.d.ts
.sanity

# ── Backend (Python & FastAPI) ──────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/

# ── Virtual Environments ────────────────────────────────────────
venv/
.venv/
env/
backend/venv/
backend/.venv/
backend/env/

# ── Database ───────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Environment Variables ──────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
frontend/.env*
backend/.env*
!.env.example
!frontend/.env.example
!backend/.env.example

# ── Testing & Coverage ─────────────────────────────────────────
/coverage
.coverage
.pytest_cache/
backend/.pytest_cache/
backend/htmlcov/
backend/.tox/
backend/.nox/

# ── Logs & Debug ───────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*
dev.log
dev.out.log
server.log
backend/*.log

# ── IDE & OS ───────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
*.pem
.vercel

# ── Workflows & Tool Artifacts ─────────────────────────────────
tool-results/
qa-*/
download/
preview*.png
qa-*.png
