# Canbri frontend — environment variables
#
# Copy this file to .env (or .env.local) and fill in real values.
# NEXT_PUBLIC_* variables are exposed to the browser — never put secrets here.

# Required. Base URL of the FastAPI backend, no trailing slash.
# The app fails to start requests without this — there is no hardcoded
# fallback, since a silent default to localhost would break silently on
# any deployed host (Vercel, etc.) that can't reach "localhost".
#
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:3001
# Production: set to the deployed backend's public URL, e.g.
# NEXT_PUBLIC_API_URL=https://api.canbri.co.zw
