# Canbri frontend — environment variables
#
# Copy this file to .env (or .env.local) and fill in real values.
# NEXT_PUBLIC_* variables are exposed to the browser — never put secrets here.

# Required. Base URL of the FastAPI backend, no trailing slash.
# The app fails to start requests without this — there is no hardcoded
# fallback, since a silent default to localhost would break silently on
# any deployed host (Vercel, etc.) that can't reach "localhost".
#
# The FastAPI backend cannot run on Vercel itself (no persistent Python
# server support in Vercel's serverless model) — it needs separate hosting
# (Railway, Render, Fly.io, etc.). This must point at that deployment.
#
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:3001
# Production: set to the deployed backend's public URL, e.g.
# NEXT_PUBLIC_API_URL=https://api.canbri.co.zw

# Required for correct canonical URLs, Open Graph tags, and JSON-LD
# structured data. Falls back to http://localhost:3000 if unset — that
# fallback is deliberate (an obviously-wrong value is safer than silently
# claiming a real domain), but it means SEO tags will be wrong in
# production until this is set.
#
# Set this to wherever the frontend is actually reachable — a *.vercel.app
# URL, or a connected custom domain once one exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production example:
# NEXT_PUBLIC_SITE_URL=https://canbri.vercel.app
