# Canbri Backend — Environment Variables
# Copy this to .env and fill in your actual values

# ── Database (Supabase PostgreSQL) ──────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# For Supabase: use the "Transaction mode" connection string (port 5432) or
# the "Session mode" (port 5432) for direct connections.
CANBRI_DATABASE_URL=postgresql+asyncpg://postgres.YOURPROJECT:YOURPASSWORD@aws-0-YOURREGION.pooler.supabase.com:6543/postgres

# ── Redis (optional — leave empty for in-memory fallback) ───────
REDIS_URL=

# ── JWT ──────────────────────────────────────────────────────────
# REQUIRED to be a real random value in production — the app refuses to
# start if ENVIRONMENT=production and this is still the placeholder below.
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_-hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────
# Must list every origin the frontend is actually served from — requests
# from any other origin are rejected by the browser. Update this to the
# real deployed frontend URL(s) before going live, e.g.
# CORS_ORIGINS=["https://canbri.vercel.app","https://canbri.co.zw"]
CORS_ORIGINS=["http://localhost:3000"]

# ── App ──────────────────────────────────────────────────────────
# local | staging | production
# Setting this to "production" changes real behavior: /docs and /redoc are
# disabled, the JWT secret guard above becomes fatal, and the seed script
# (below) skips creating a default admin account.
ENVIRONMENT=local

# The site's one super-admin account is created once via the one-time
# bootstrap signup at /admin (POST /auth/register, gated by a real
# "no admin exists yet" database check) — there is no env-var admin
# credential to set here.

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Cloudflare R2 (media uploads) ─────────────────────────────────
# R2_PUBLIC_URL is the bucket's public dev domain or a custom domain
# mapped to the bucket, no trailing slash (e.g. https://media.canbri.co.zw
# or https://pub-xxxxx.r2.dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=canbri-media
R2_PUBLIC_URL=
